# A 4 GB iPhone (iPhone 12, 12 mini, 13, 13 mini, SE 3rd generation): room under iOS's memory limit for a game whose BC textures are decoded on the CPU.
# Build with --env-file scripts/iphone-4gb.env; a line in Documents/env.txt on the phone wins over these. Tested: Mario Kart 8 Deluxe 3.0.5 on an iPhone 13 mini, a whole Grand Prix (README.md)
DM_OPMODE=0
DM_BC_MAX_SIZE=128
DM_ZERO_PAGES=10
DM_BC_FREE_BLOCKS=1
